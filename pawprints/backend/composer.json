{
    "name": "cerberus-paw/pawprints",
    "description": "Sitio de la librería PAWPrints (TPs de Programación en Ambiente Web, UNLu).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "twig/twig": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "PawPrints\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    }
}
