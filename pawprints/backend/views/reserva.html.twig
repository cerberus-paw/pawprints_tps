{#
  El formulario de reserva (TP3, punto 5; Mateo), que guarda la reserva y avisa al personal.

  Desde el carrito (TP5-11) puede tener varios libros: un renglón por libro, con su desplegable
  (libro_id[]) y su cantidad (cantidad[]). Sin JavaScript llega con los renglones que pidió la
  dirección; reserva.js agrega y quita renglones y mantiene la tarjeta de resumen al día.

  Variables (ReservaController::mostrar):
    libros        — los de los desplegables: id, titulo, autor, precio, stock e imagen
    renglones     — los elegidos, cada uno con libro_id y cantidad como texto; al menos uno
    elegidos      — los de la tarjeta de resumen: los renglones con un libro que existe, con el
                    libro, la cantidad y el subtotal
    total         — la suma de los subtotales, en pesos
    valores       — lo que ya escribió el usuario, para no hacérselo escribir de nuevo
    errores       — campo => mensaje; los de cada renglón van con el id de su control
                    («libro-0», «cantidad-1»), y «envio» si no se pudo guardar
    maxEjemplares — el tope de ejemplares de cada libro
    maxLibros     — el tope de libros distintos
    trampa        — el nombre del campo trampa para bots
#}
{% extends 'base.html.twig' %}
{% import 'macros/campos.html.twig' as campos %}

{% block contenido %}
{# El id del control de cada campo, para que el resumen de errores enlace a él. #}
{% set controles = {libros: 'libro-0'} %}
  <main>

    <section aria-labelledby="titulo-reserva">
      <h1 id="titulo-reserva">Formulario de Reserva</h1>
      <p>
        Reservá tu ejemplar de manera gratuita y retiralo en nuestra
        librería física en Mercedes cuando te convenga.
      </p>
    </section>

    <section aria-label="Contenido de la página de reserva">

      <article aria-labelledby="subtitulo-formulario">
        <h2 id="subtitulo-formulario" hidden>Datos de la reserva</h2>

        {% if errores.envio is defined %}
        <p role="alert">{{ errores.envio }}</p>
        {% elseif errores is not empty %}
        {# role="alert" hace que el lector de pantalla lo anuncie apenas carga la página. #}
        <div role="alert">
          <p>Revisá estos datos antes de enviar la reserva:</p>
          <ul>
            {% for campo, texto in errores %}
            <li><a href="#{{ controles[campo] ?? campo }}">{{ texto }}</a></li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}

        {# Sin novalidate: el navegador valida primero con los atributos de cada campo, y el
           servidor vuelve a validar todo, porque lo del navegador se saltea fácil. #}
        <form action="/reserva" method="post" aria-labelledby="titulo-reserva">

          <fieldset>
            <legend>Datos del solicitante</legend>

            <div>
              <label for="nombre">Nombre completo <abbr title="campo obligatorio">*</abbr></label>
              <input type="text" id="nombre" name="nombre" value="{{ valores.nombre }}"
                     placeholder="Ej. Juan Pérez García" required maxlength="100"
                     autocomplete="name"{{ campos.atributos('nombre', errores) }}>
              {{ campos.error('nombre', errores) }}
            </div>

            <div>
              <div>
                <label for="email">Correo electrónico <abbr title="campo obligatorio">*</abbr></label>
                <input type="email" id="email" name="email" value="{{ valores.email }}"
                       placeholder="juan.perez@ejemplo.com" required maxlength="254"
                       autocomplete="email"{{ campos.atributos('email', errores) }}>
                {{ campos.error('email', errores) }}
              </div>

              <div>
                <label for="telefono">Teléfono de contacto <abbr title="campo obligatorio">*</abbr></label>
                <input type="tel" id="telefono" name="telefono" value="{{ valores.telefono }}"
                       placeholder="+54 9 11 1234-5678" required maxlength="20"
                       pattern="[\+]?[\d\s\-\(\)]{7,20}" autocomplete="tel"{{ campos.atributos('telefono', errores) }}>
                {{ campos.error('telefono', errores) }}
              </div>
            </div>
          </fieldset>

          <fieldset data-renglones data-max-libros="{{ maxLibros }}">
            <legend>Libros a reservar</legend>

            {% for renglon in renglones %}
            {% set i = loop.index0 %}
            <div data-renglon>
              <div>
                <label for="libro-{{ i }}">{{ loop.length > 1 ? 'Libro ' ~ loop.index : 'Seleccioná el libro a reservar' }} <abbr title="campo obligatorio">*</abbr></label>
                {# Lista cerrada armada desde el catálogo: el value es el id del libro. Los data-*
                   son para que reserva.js arme la tarjeta de resumen sin pedirle nada al servidor. #}
                <select id="libro-{{ i }}" name="libro_id[]" required{{ campos.atributos('libro-' ~ i, errores) }}>
                  <option value="" disabled{% if renglon.libro_id == '' %} selected{% endif %}>— Seleccioná un libro —</option>
                  {% for opcion in libros %}
                  <option value="{{ opcion.id }}" data-precio="{{ opcion.precio }}" data-stock="{{ opcion.stock }}" data-imagen="{{ opcion.imagen }}" data-autor="{{ opcion.autor }}" data-titulo="{{ opcion.titulo }}"{% if (opcion.id ~ '') is same as(renglon.libro_id) %} selected{% endif %}{% if opcion.stock == 0 %} disabled{% endif %}>{{ opcion.titulo }} — {{ opcion.autor }}{% if opcion.stock == 0 %} (sin stock){% endif %}</option>
                  {% endfor %}
                </select>
                {{ campos.error('libro-' ~ i, errores) }}
              </div>

              <div>
                <label for="cantidad-{{ i }}">Cantidad <abbr title="campo obligatorio">*</abbr></label>
                <input type="number" id="cantidad-{{ i }}" name="cantidad[]" value="{{ renglon.cantidad }}"
                       min="1" max="{{ maxEjemplares }}" required{{ campos.atributos('cantidad-' ~ i, errores) }}>
                {{ campos.error('cantidad-' ~ i, errores) }}
              </div>
            </div>
            {% endfor %}

            {{ campos.error('libros', errores) }}
            <small>Hasta {{ maxEjemplares }} ejemplares de cada libro y {{ maxLibros }} libros distintos por reserva.</small>
          </fieldset>

          <fieldset>
            <legend>Información adicional</legend>

            <div>
              <label for="comentarios">Comentarios adicionales</label>
              <textarea id="comentarios" name="comentarios" rows="5" maxlength="500"
                        placeholder="¿Deseás que lo envolvamos para regalo? ¿Alguna instrucción sobre la recogida?"{{ campos.atributos('comentarios', errores) }}>{{ valores.comentarios }}</textarea>
              {{ campos.error('comentarios', errores) }}
            </div>
          </fieldset>

          {# Trampa para bots: hidden la saca de la vista y del lector de pantalla, así que sólo la
             completa un programa que llena todos los campos que encuentra. #}
          <div hidden>
            <label for="{{ trampa }}">No completar este campo</label>
            <input type="text" id="{{ trampa }}" name="{{ trampa }}" tabindex="-1" autocomplete="off">
          </div>

          <div>
            <button type="submit">Enviar Reserva</button>
          </div>

        </form>
      </article>

      <aside aria-labelledby="titulo-resumen-libro">
        <h2 id="titulo-resumen-libro" hidden>Resumen de la reserva</h2>

        {# Sin JavaScript la tarjeta muestra los libros con los que se llegó (de la ficha o del
           carrito) o los que se eligieron antes de un error; reserva.js la sigue al día. #}
        <article aria-labelledby="titulo-resumen-libro">
          <header data-resumen{% if elegidos is empty %} hidden{% endif %}>
            <ul>
              {% for elegido in elegidos %}
              <li>
                <img src="/img/{{ elegido.libro.imagen }}" alt="" width="60" height="80">
                <div>
                  <h3>{{ elegido.libro.titulo }}</h3>
                  <p>{{ elegido.libro.autor }}</p>
                  <p>{{ elegido.cantidad }} × <data value="{{ elegido.libro.precio }}">{{ elegido.libro.precio|pesos }}</data></p>
                </div>
              </li>
              {% endfor %}
            </ul>
            <p><strong>Total: <data value="{{ total }}">{{ total|pesos }}</data></strong></p>
            <hr>
          </header>

          <section aria-labelledby="titulo-beneficios">
            <h3 id="titulo-beneficios" hidden>Beneficios de reservar en tienda</h3>
            <ul>
              <li>Te guardamos los libros por 10 días hábiles.</li>
              <li>Te llega un correo con el detalle de la reserva.</li>
              <li>Pago directo al retirarlo en la tienda física.</li>
            </ul>
          </section>
        </article>
      </aside>

    </section>

  </main>
{% endblock %}
