{#
  El carrito, compartido por todas las páginas, y el pie institucional con el contacto. Los datos
  de la tienda vienen de Models/Tienda (variable «tienda», que App comparte con todas las vistas).

  marcarTienda — si el pie marca la tienda como BookStore de schema.org (TP5, consigna 8). Lo
  piden sólo la portada y «Sobre nosotros», donde la tienda es de lo que habla la página; en el
  catálogo o en una ficha lo principal es el libro, y repetir la tienda en todas las páginas no le
  agrega nada al buscador.
#}
{% import 'macros/microdata.html.twig' as microdata %}
{% set md = marcarTienda ?? false %}
  <aside id="carrito">
    <h2>Carrito de compras</h2>
    <p>El carrito está vacío.</p>
  </aside>

  <hr>

  <footer{% if md %} itemscope itemtype="https://schema.org/BookStore"{% endif %}>
    {%- if md %}
    {{ microdata.tienda() }}
    {%- endif %}

    <section>
      <h2{% if md %} itemprop="name"{% endif %}>{{ tienda.nombre }}</h2>
      <p{% if md %} itemprop="description"{% endif %}>
        Un santuario para las palabras impresas y las almas lectoras.
        Visitanos en nuestra tienda física en Mercedes o explorá todo
        nuestro catálogo en línea.
      </p>
    </section>

    <nav aria-label="Navegación del pie de página">
      <h2>Navegación</h2>
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo">Catálogo completo</a></li>
        <li><a href="/sobre-nosotros">Sobre Nosotros</a></li>
        <li><a href="/personal/ingresar">Ingreso del personal</a></li>
      </ul>
    </nav>

    <section>
      <h2>Contacto &amp; Visita</h2>
      {# Los itemprop van en un <span> dentro de los enlaces: en un <a>, la microdata toma el
         href («tel:…») y no el texto. #}
      <address>
        {{ microdata.direccion(tienda.direccion, md) }}<br>
        Teléfono: <a href="tel:{{ tienda.telefonoEnlace }}"><span{% if md %} itemprop="telephone"{% endif %}>{{ tienda.telefono }}</span></a><br>
        Correo: <a href="mailto:{{ tienda.correo }}"><span{% if md %} itemprop="email"{% endif %}>{{ tienda.correo }}</span></a>
      </address>
      <p>Horario de atención: {% if md %}<meta itemprop="openingHours" content="{{ tienda.horarioSchema }}">{% endif %}{{ tienda.horario }}</p>
    </section>

    <section>
      <h2>Seguinos</h2>
      <ul>
        <li><a href="https://www.instagram.com/" rel="external">Instagram</a></li>
        <li><a href="https://www.facebook.com/" rel="external">Facebook</a></li>
        <li><a href="https://x.com/" rel="external">X</a></li>
      </ul>
    </section>

    <hr>

    <p><small>&copy; 2026 Librería PAWPrints. Todos los derechos reservados.</small></p>
    <p><small>Mercedes, Argentina</small></p>

  </footer>
